# Create secrets.enc.env with the repository's SOPS/age workflow.
# BORG_REPO may be a remote SSH repository (recommended) or a mounted local repo.
BORG_REPO=repo_url
BORG_PASSPHRASE=replace-with-a-long-random-secret

# Match the Immich database credentials from docker/immich/secrets.envc.env.
DB_DATABASE_NAME=immich
DB_USERNAME=postgres
DB_PASSWORD=replace-with-the-immich-database-password
